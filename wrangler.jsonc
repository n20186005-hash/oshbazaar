{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oshbazaar",
  "main": "worker.ts",
  "compatibility_date": "2026-08-25",
  "observability": { "enabled": true },
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
}
